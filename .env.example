# ─────────────────────────────────────────────────────────────
# FreeF1 server — example environment
# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# The server refuses to boot in production with any default below.
# ─────────────────────────────────────────────────────────────

# ── Admin dashboard ──────────────────────────────────────────
ADMIN_USER=change-me
ADMIN_PASS=use-a-long-random-password
# Production refuses to boot with a password shorter than this (default 12).
# ADMIN_PASS_MIN_LENGTH=12
# Optional: restrict the whole dashboard to your own addresses (exact IPs or
# IPv4 CIDR). Anyone else gets a 404, so the panel is invisible to scanners.
# ADMIN_IP_ALLOWLIST=41.13.0.0/16,102.132.7.9
# Signs the admin session cookie. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-64-random-chars

# ── Visitor tracking ─────────────────────────────────────────
# Signs the short-lived heartbeat tokens issued to the public site.
VISITOR_SECRET=change-me-to-another-random-string
# Keeps stable visitor hashes independent of ADMIN_SECRET, so rotating the
# admin secret does not reset the all-time unique-visitor count.
UNIQUE_VISITOR_HASH_SECRET=change-me-to-a-third-random-string
# Add this once to carry a count over from an older deployment.
UNIQUE_VISITOR_BASELINE=0

# ── Public site ──────────────────────────────────────────────
AUTHORIZED_DOMAIN=freef1.netlify.app
# How many reverse proxies sit in front of this process. 1 = Render's router
# (the default in production). 2 = Cloudflare in front of Render. 0 = no proxy
# (local). This is what makes the client IP unforgeable: set it to the number
# of hops you actually run, because every rate limit, the login lockout and the
# unique-visitor budget key off it. Too low and every viewer looks like one
# IP; too high and a client-supplied X-Forwarded-For is trusted again.
# TRUST_PROXY_HOPS=1
# Comma-separated origins allowed to call the API cross-site.
ALLOWED_ORIGIN=https://freef1.netlify.app
# Folder containing the site's index.html (set this on Render).
# DEV_DIR=/opt/render/project/Development-FreeF1

# ── Durable storage (REQUIRED in production) ─────────────────
# Render wipes the instance disk on every rebuild. Without Upstash, analytics,
# unique visitors, news and maintenance mode reset to empty.
# Create a free Redis DB at https://upstash.com → REST API → copy URL + token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── OpenF1 proxy ─────────────────────────────────────────────
# OPENF1_API=https://api.openf1.org/v1
# Optional: raises the free-tier limits and lifts the live-session lock.
# OPENF1_API_KEY=

# ── Discord companion bot (optional) ─────────────────────────
# Leave DISCORD_BOT_TOKEN unset to run the site with no bot at all.
# DISCORD_BOT_TOKEN=
# Register slash commands instantly in one server instead of globally (1h).
# DISCORD_GUILD_ID=
# SITE_URL=https://freef1.netlify.app
# DISCORD_INVITE=https://discord.gg/your-invite
# Discord user id allowed to run owner commands. Bot will not start without it.
# DISCORD_OWNER_ID=
# PUBLIC_SSE_MAX=400

# ── Race audio relay (optional) ──────────────────────────────
# Default source for "/watchparty start" — any URL ffmpeg can open
# (HTTP/HTTPS, HLS/m3u8, MP3, AAC...). Discord bots can relay AUDIO into a
# voice channel; they cannot stream video. See bot/STREAMING.md.
# FREEF1_AUDIO_URL=https://example.com/race-commentary.m3u8
# Override the ffmpeg binary; otherwise ffmpeg-static or PATH is used.
# FFMPEG_PATH=

# ── Abuse budgets (see the audit in RENDER.md) ───────────────
# New visitor identities one address may add to the permanent all-time total
# per hour. Over budget the viewer still counts as live, they just cannot
# inflate the headline number in a loop.
# NEW_IDENTITY_BUDGET_PER_IP_HOUR=60
# Log-only tripwire for the whole instance, per hour.
# NEW_IDENTITY_ALERT_PER_HOUR=600
# Long-lived public SSE sockets per address (the global cap is PUBLIC_SSE_MAX).
# PUBLIC_SSE_MAX_PER_IP=4
# Failed admin logins from one address+username before lockout, and the
# doubling lockout window (15m -> 30m -> 1h ... capped at LOGIN_MAX_LOCK_MS).
# Distributed guessing is additionally counted per username, at
# LOGIN_MAX_FAILURES * LOGIN_USER_FAILURE_MULTIPLIER.
# LOGIN_MAX_FAILURES=5
# LOGIN_BASE_LOCK_MS=900000
# LOGIN_MAX_LOCK_MS=21600000
# LOGIN_USER_FAILURE_MULTIPLIER=4
# Upstream request budget for the free Jolpica API (shared by all viewers).
# JOLPI_MAX_PER_MINUTE=120
# LRU caps for the OpenF1/career caches and the daily durable-snapshot writes,
# so client-chosen query strings cannot grow memory or the Redis keyspace.
# OPENF1_CACHE_MAX=400
# OPENF1_SNAPSHOT_MAX=400
# OPENF1_SNAPSHOT_WRITES_PER_DAY=2000
# CAREER_CACHE_MAX=200

# ── Tuning ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# DATA_DIR=/var/data/freef1
# GEO_ENABLED=true
# HEARTBEAT_TIMEOUT_MS=60000
# VISITOR_RATE_LIMIT_MAX=30
# ANALYTICS_HOURLY_RETENTION_HOURS=336
# ANALYTICS_DAILY_RETENTION_DAYS=90
