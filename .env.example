# FreeF1 server example. Never commit real values.

# ── Required in production ────────────────────────────────────────
NODE_ENV=production
PORT=3000
ADMIN_USER=change-me
ADMIN_PASS=use-a-long-random-password
ADMIN_SECRET=generate-64-random-hex-characters
VISITOR_SECRET=generate-another-random-secret
# Keep this stable when rotating the other secrets.
UNIQUE_VISITOR_HASH_SECRET=generate-a-third-random-secret

AUTHORIZED_DOMAIN=freef1.netlify.app
ALLOWED_ORIGIN=https://freef1.netlify.app
# Render directly = 1; another proxy in front of Render = 2; local = 0.
TRUST_PROXY_HOPS=1
# Render's edge overwrites this before forwarding the request.
CLIENT_IP_HEADER=cf-connecting-ip

# Preferred durable provider: a standard TLS Redis/Valkey URL. Redis Cloud's
# free database is sufficient for this service. Render's disk is ephemeral.
REDIS_URL=rediss://default:password@host:port
# REDIS_TIMEOUT_MS=3500

# Legacy migration input only. REDIS_URL takes precedence when both exist.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── Playback ──────────────────────────────────────────────────────
# The repository ships data/stream-targets.json. Override it without a commit:
# STREAM_TARGETS_JSON={"sky-sports-f1":{"url":"https://provider.example/embed"}}
# STREAM_TICKETS=true
# STREAM_TICKET_TTL_MS=3600000
# STREAM_TICKET_RATE_MAX=120
# SITE_TICKETS=true
# SITE_TICKET_TTL_MS=21600000
# SITE_TICKET_RATE_MAX=60
# Self-hosted relays are permanently retired; RELAYS_ENABLED is ignored.

# ── Render 512 MB / high concurrency ─────────────────────────────
NODE_OPTIONS=--max-old-space-size=384
PUBLIC_SSE_MAX=1200
PUBLIC_SSE_MAX_PER_IP=32
# The matching Netlify patch beats every two minutes.
PRESENCE_TTL_MS=270000
# Keep analytics freshness aligned with presence freshness.
HEARTBEAT_TIMEOUT_MS=270000
PRESENCE_LEAVE_GRACE_MS=125000
SSE_HEARTBEAT_MS=25000
# Avoid one third-party geo call for every new viewer.
GEO_ENABLED=false

# ── Optional bot and upstreams ────────────────────────────────────
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_OWNER_ID=
# DISCORD_INVITE=https://discord.gg/your-invite
# SITE_URL=https://freef1.netlify.app
# OPENF1_API_KEY=
# Direct browser audio feed; the server returns this URL but never relays bytes.
# AUDIO_FEED_URL=https://provider.example/commentary.m3u8
# SELFCHECK_TOKEN=another-random-secret

# ── Security / abuse tuning ──────────────────────────────────────
# ADMIN_PASS_MIN_LENGTH=12
# ADMIN_IP_ALLOWLIST=41.13.0.0/16,102.132.7.9
# LOGIN_MAX_FAILURES=5
# LOGIN_BASE_LOCK_MS=900000
# LOGIN_MAX_LOCK_MS=21600000
# LOGIN_USER_FAILURE_MULTIPLIER=4
# NEW_IDENTITY_BUDGET_PER_IP_HOUR=60
# NEW_IDENTITY_ALERT_PER_HOUR=600
# VISITOR_RATE_LIMIT_MAX=30
# HEARTBEAT_RATE_LIMIT_MAX=20
# HEARTBEAT_IP_RATE_LIMIT_MAX=600
# EVENT_RATE_LIMIT_MAX=30
# EVENT_IP_RATE_LIMIT_MAX=600

# ── Cache/analytics tuning ────────────────────────────────────────
# UNIQUE_VISITOR_BASELINE=0
# OPENF1_CACHE_MAX=400
# OPENF1_SNAPSHOT_MAX=400
# OPENF1_SNAPSHOT_WRITES_PER_DAY=2000
# CAREER_CACHE_MAX=200
# JOLPI_MAX_PER_MINUTE=120
# ANALYTICS_HOURLY_RETENTION_HOURS=336
# ANALYTICS_DAILY_RETENTION_DAYS=90
