# Render's free tier builds with 512 MB of memory. A plain `npm install` here
# pulls ffmpeg-static (a 77 MB static binary) and @discordjs/opus, which falls
# back to compiling from source with node-gyp when no prebuild matches the
# platform — and node-gyp is what blows the 512 MB budget. jsdom is dev-only.
#
# Skipping both drops the tree from ~151 MB to ~62 MB with no native build step
# at all, which fits comfortably.
#
# Neither package is needed to serve the site: bot/voice-relay.js already
# requires @discordjs/voice and ffmpeg-static inside try/catch and reports
# itself unavailable when they are missing, so Discord voice simply goes quiet
# instead of taking the server down. To bring voice back on a bigger plan,
# delete this file (or set optional=true) and make sure ffmpeg is on PATH.
omit=dev
optional=false
