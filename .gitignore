node_modules/
# A symlink is not matched by the trailing-slash form above; local dev links
# node_modules to a persistent vendor dir, and that must never be committed.
node_modules
data/*
!data/.gitkeep
# The feed addresses ship WITH the backend, deliberately: the site never holds
# them, so the server is the only thing that needs them — and this way nobody
# has to configure anything on the host. This one file is the exception to the
# rule above; keep the rest of data/ out of the repo. The addresses are as
# private as this repository is.
!data/stream-targets.json
# Runtime state (visitor hashes, analytics, news, overrides) belongs to the
# deploy, not the repo: committing it leaks state and seeds fresh installs.
npm-debug.log*
.env
.env.*
!.env.example
.DS_Store
